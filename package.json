{
  "name": "baby-tracker",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "A private, offline-first baby tracker. Free forever, no account, no ads, no telemetry.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beingmechon/baby-tracker.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "SHOT_DIR=docs/screenshots node scripts/smoke.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "fonts": "node scripts/vendor-fonts.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4"
  }
}
